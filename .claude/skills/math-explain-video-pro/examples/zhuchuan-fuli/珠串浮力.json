  "funcs": {
   "Hw": "(yb) => { let lo = 5.5, hi = 12; for (let k = 0; k < 60; k++) { const m = (lo + hi) / 2; let s = 0; for (let i = 0; i < 8; i++) s += Math.min(1, Math.max(0, m - (yb + 1.5 * i))); if (m - 5.5 - 0.5 * s > 0) hi = m; else lo = m; } return (lo + hi) / 2; }",
   "Sub": "(yb) => { const h = Hw(yb); let s = 0; for (let i = 0; i < 8; i++) s += Math.min(1, Math.max(0, h - (yb + 1.5 * i))); return s; }",
   "Nf": "(yb) => { const h = Hw(yb); let n = 0; for (let i = 0; i < 8; i++) if (h >= yb + 1.5 * i + 1 - 1e-6) n++; return n; }"
