       {"say": "也就是 1−a 不超过右边的最小值。",
        "do": [{"at": "^", "hide": "pk", "dur": 0.4},
               {"at": "也就是", "note": "即 $1-a\\le\\left[a\\,g\\left(x_2+\\dfrac{3\\pi}{2}\\right)\\right]_{\\min}$", "cls": "sm"}]},
       {"say": "右边的最小值和 a 的正负有关，分三种情况。"},
       {"say": "a>0 时，g 最小是 −1/2，右边最小是 −a/2。",
        "do": [{"at": "^", "hide": "lbRmin", "dur": 0.3},
               {"at": "右边最小", "show": "lbR"}]},
       {"say": "由 1−a≤−a/2，解得 a≥2。",
        "do": [{"at": "解得", "note": "$a>0$：$1-a\\le-\\dfrac{a}{2}$，$a\\ge2$"}]},
       {"say": "a=0 时，右边恒为0，1≤0 不成立。",
        "do": [{"at": "^", "hide": ["barR", "lbR", "lbCaseP"], "dur": 0.4},
               {"at": "^", "tween": {"a": 0}, "dur": 1.0},
               {"at": "^", "show": "lbCase0", "delay": 0.8},
               {"at": "恒为0", "show": "lbR0"},
               {"at": "不成立", "focus": ["ptL", "ptR"], "color": "red", "dur": 1.2},
               {"at": "不成立", "note": "$a=0$：$1\\le0$，舍去"}]},
       {"say": "a<0 时，g 越大，右边越小，没有最小值，也不成立。",
        "do": [{"at": "^", "hide": ["lbR0", "lbCase0"], "dur": 0.3},
               {"at": "^", "tween": {"a": -1}, "dur": 1.0},
               {"at": "^", "show": "lbCaseN", "delay": 0.8},
               {"at": "右边越小", "show": ["barR", "lbR"], "dur": 0.8},
               {"at": "不成立", "note": "$a<0$：右边没有最小值，舍去"}]},
       {"say": "三种情况合起来，a 的取值范围是 a≥2。",
        "do": [{"at": "取值范围", "note": "$a$ 的取值范围是 $[2,+\\infty)$", "np": "（ⅱ）", "cls": "ans"}]}
     ]},

