        "do": [{"at": "^", "note": "$g\\left(x_2+\\dfrac{3\\pi}{2}\\right)\\in\\left[-\\dfrac12,+\\infty\\right)$", "cls": "key"}]}
     ]},

    {"id": "s6", "layout": "board", "num": "05", "title": "比较两边，定 $a$ 的范围", "tag": "第（2）问（ⅱ）",
     "view": {"x": [54.3, 65.7], "y": [-3.1, 4.05], "free": true},
     "beats": [
       {"say": "把两边能取到的值，画在数轴上比一比。",
        "do": [{"at": "^", "hide": ["axTh", "tkU", "tkUym", "cosTh", "fmCosT", "W3", "w3a", "w3b", "lbW3", "hiW3", "W4", "w4a", "w4b", "lbW4", "hiW4", "axL", "cL", "fmLog", "tkT2", "cLHi2", "segT2", "eT0P", "eT2", "pMin", "lbMin"], "dur": 0.4},
               {"at": "数轴", "show": ["axV", "tkV"], "dur": 0.8}]},
       {"say": "左边 g(x₁)−a，最小是 1−a，往上没有尽头。",
        "do": [{"at": "左边", "show": ["barL", "hdL"], "dur": 0.8},
               {"at": "最小", "show": ["ptL", "lbL"]}]},
       {"say": "右边是 a 乘 g(x₂+3π/2)，先以 a>0 为例画出来。",
        "do": [{"at": "右边", "show": "hdR"},
               {"at": "为例", "show": ["barR", "ptR", "lbRmin", "lbCaseP"], "dur": 0.8}]},
       {"say": "存在 x₁，只要左边能挑出一个值。",
        "do": [{"at": "挑出", "show": ["pk", "pkL"]}]},
       {"say": "对任意 x₂，这个值要不超过右边的每一个值。",
        "do": [{"at": "不超过", "show": "cmp", "dur": 0.8},
               {"at": "每一个", "focus": "barR", "color": "orange", "dur": 1.4}]},
       {"say": "挑左边最小的最有利，只要它不超过右边的最小值。",
        "do": [{"at": "^", "hide": "pkL", "dur": 0.3},
               {"at": "最小的", "tween": {"pb": -2}, "dur": 1.6},
